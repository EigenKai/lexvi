# LexVi web — environment variables.
# Copy to .env.local (git-ignored; never commit it) and fill in what you need.
# Every variable is optional: with nothing set, the app runs on the typed mocks in lib/api/mock.ts
# and shows the "Dữ liệu minh hoạ" flag.
#
# NEXT_PUBLIC_* values are inlined into the browser bundle at build time:
#   - they are PUBLIC (anyone can read them) — never put a key or token in one;
#   - after changing one, restart `pnpm dev` or re-run `pnpm build`.

# ── Used now ─────────────────────────────────────────────────────────────────────────────────
# Base URL of role B's backend (no trailing slash needed), e.g. http://localhost:8000
# Enables POST {url}/ask and the proposed GET {url}/dieu-khoan/{id}.
# The backend must allow this app's origin via CORS (the JSON POST triggers a preflight).
NEXT_PUBLIC_LEXVI_API_URL=

# Request timeout in milliseconds for backend calls. Default: 60000.
NEXT_PUBLIC_LEXVI_API_TIMEOUT_MS=

# Disable Next.js anonymous telemetry (recommended).
NEXT_TELEMETRY_DISABLED=1

# ── Not read by any code yet (reserved for voice input, if it isn't proxied through B) ───────
# Server-only: read only inside a Next route handler, NEVER prefixed with NEXT_PUBLIC_.
# META_API_KEY=
# META_API_BASE_URL=https://api.meta.ai/v1
