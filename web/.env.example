# LexVi web — environment variables.
# Copy to .env.local (git-ignored; never commit it) and fill in what you need.
# With nothing set, the app runs on the typed mocks in lib/api/mock.ts and shows the
# "Dữ liệu minh hoạ" / "Illustrative data" flag.
#
# NEXT_PUBLIC_* values are inlined into the browser bundle at build time:
#   - they are PUBLIC (anyone can read them) — never put a key or token in one;
#   - after changing one, restart `pnpm dev` or re-run `pnpm build`.
# Put each value alone on its line: no trailing "# comment" after a value.

# ── Backend (role B) ─────────────────────────────────────────────────────────────────────────
# Base URL of the FastAPI backend, e.g. http://localhost:8000 (POST /ask, GET /runs/{id}, POST /ingest).
# The backend must allow this app's origin via LEXVI_CORS_ORIGINS.
NEXT_PUBLIC_LEXVI_API_URL=

# Request timeout in milliseconds for backend calls. /ask takes ~30 s; the backend may retry up to 180 s.
NEXT_PUBLIC_LEXVI_API_TIMEOUT_MS=180000

# ── Voice and photo input (server-only: read only by app/api/* route handlers) ────────────────
# Meta Model API key. NEVER prefix with NEXT_PUBLIC_. Used by /api/transcribe (Muse Voice
# Transcribe) and /api/read-image (Muse Spark). Without it, voice/photo say "not configured"
# (or use the illustrative canned result while the app runs on mocks).
MODEL_API_KEY=
# Optional overrides.
MODEL_API_BASE_URL=https://api.meta.ai/v1
MODEL_API_MODEL=muse-spark-1.3

# Disable Next.js anonymous telemetry (recommended).
NEXT_TELEMETRY_DISABLED=1
